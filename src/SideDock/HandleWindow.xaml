<Window x:Class="SideDock.HandleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="28"
        Height="144"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False">
    <Button Click="HandleButton_Click"
            MouseEnter="HandleButton_MouseEnter"
            MouseLeave="HandleButton_MouseLeave"
            AutomationProperties.Name="Toggle SideDock"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            Cursor="Hand"
            Focusable="False"
            ToolTip="Hover or click to open SideDock (Ctrl+Alt+Space)">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Pill"
                        BorderThickness="1,1,0,1"
                        CornerRadius="10,0,0,10"
                        Padding="3,8,1,7">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#E84A4A4A" Offset="0" />
                            <GradientStop Color="#C8181818" Offset="0.42" />
                            <GradientStop Color="#E8323232" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0.45,0" EndPoint="0.55,1">
                            <GradientStop Color="#E8F0EEE8" Offset="0" />
                            <GradientStop Color="#685C5A56" Offset="0.5" />
                            <GradientStop Color="#90AAA8A2" Offset="1" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="SideDock"
                                   Foreground="#E4E0D8"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                        <TextBlock x:Name="Chevron"
                                   Grid.Row="1"
                                   Text="{Binding Chevron, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Foreground="#E4E0D8"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0,5,0,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Border Grid.RowSpan="2"
                                Width="1"
                                Margin="1,10,0,10"
                                HorizontalAlignment="Left"
                                Background="#A0FFFFFF"
                                Opacity="0.58"
                                IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Pill" Property="Background" Value="#EE484848" />
                        <Setter TargetName="Pill" Property="BorderBrush" Value="#E8D8D4CB" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Pill" Property="Background" Value="#F00A111A" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</Window>
