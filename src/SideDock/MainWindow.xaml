<Window x:Class="SideDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SideDock.Models"
        Title="SideDock"
        Width="410"
        Height="720"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="Transparent"
        Foreground="#F4F8FC"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        SizeChanged="Window_SizeChanged"
        Deactivated="Window_Deactivated"
        MouseEnter="Window_MouseEnter"
        PreviewKeyDown="Window_PreviewKeyDown"
        AllowDrop="True"
        Drop="Drawer_Drop"
        DragOver="Drawer_DragOver">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F7FAFD" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#BBC8D7" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#8291A5" />
        <SolidColorBrush x:Key="AccentBrush" Color="#D8D4CB" />
        <SolidColorBrush x:Key="AccentBrightBrush" Color="#F0EEE8" />
        <LinearGradientBrush x:Key="GlassControlBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#403F3F3F" Offset="0" />
            <GradientStop Color="#20151515" Offset="0.58" />
            <GradientStop Color="#34303030" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassControlHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#70565656" Offset="0" />
            <GradientStop Color="#38232323" Offset="0.62" />
            <GradientStop Color="#58454545" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0.45,0" EndPoint="0.55,1">
            <GradientStop Color="#68D0CCC4" Offset="0" />
            <GradientStop Color="#28303030" Offset="0.28" />
            <GradientStop Color="#50050505" Offset="0.5" />
            <GradientStop Color="#28303030" Offset="0.72" />
            <GradientStop Color="#68AAA8A2" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassBorderStrongBrush" StartPoint="0.45,0" EndPoint="0.55,1">
            <GradientStop Color="#A0F0EEE8" Offset="0" />
            <GradientStop Color="#585C5A56" Offset="0.28" />
            <GradientStop Color="#70101010" Offset="0.5" />
            <GradientStop Color="#585C5A56" Offset="0.72" />
            <GradientStop Color="#A0C8C5BE" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassTileBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#38383838" Offset="0" />
            <GradientStop Color="#18151515" Offset="0.62" />
            <GradientStop Color="#302C2C2C" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="MenuSurfaceBrush" Color="#E6151515" />
        <LinearGradientBrush x:Key="DrawerGlassBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#383A3A3A" Offset="0" />
            <GradientStop Color="#10000000" Offset="0.5" />
            <GradientStop Color="#282A2A2A" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SpecularBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00FFFFFF" Offset="0" />
            <GradientStop Color="#70F0EEE8" Offset="0.28" />
            <GradientStop Color="#38AAA8A2" Offset="0.7" />
            <GradientStop Color="#00FFFFFF" Offset="1" />
        </LinearGradientBrush>

        <ControlTemplate x:Key="FolderIconTemplate" TargetType="Control">
            <Viewbox Stretch="Uniform">
                <Grid Width="32" Height="32">
                    <Path Data="M3,9 C3,7.34 4.34,6 6,6 H12.6 L15.7,9 H26 C27.66,9 29,10.34 29,12 V24 C29,26.21 27.21,28 25,28 H6 C3.79,28 2,26.21 2,24 V10 C2,9.45 2.45,9 3,9 Z"
                          Fill="#D99B16" />
                    <Path Data="M3,12 C3,10.9 3.9,10 5,10 H27 C28.1,10 29,10.9 29,12 V24 C29,26.21 27.21,28 25,28 H6 C3.79,28 2,26.21 2,24 V13 C2,12.45 2.45,12 3,12 Z">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFDA5A" Offset="0" />
                                <GradientStop Color="#F2B321" Offset="1" />
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Path Data="M5,12.5 H26"
                          Stroke="#FFF3A6"
                          StrokeThickness="1"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Opacity="0.72" />
                </Grid>
            </Viewbox>
        </ControlTemplate>

        <ControlTemplate x:Key="PdfIconTemplate" TargetType="Control">
            <Viewbox Stretch="Uniform">
                <Grid Width="32" Height="32">
                    <Path Data="M6,2 H20 L27,9 V30 H6 Z" Fill="#C93838" />
                    <Path Data="M20,2 V9 H27 Z" Fill="#FF8A80" />
                    <Path Data="M20,2 V9 H27" Fill="Transparent" Stroke="#FFD0D0" StrokeThickness="0.8" />
                    <Border Margin="4,15,1,4" Background="#F7FAFD" CornerRadius="1">
                        <TextBlock Text="PDF"
                                   Foreground="#A92020"
                                   FontFamily="Segoe UI"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Viewbox>
        </ControlTemplate>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="{StaticResource GlassControlBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LiquidButton"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Grid>
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="14"
                                        Margin="1"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Height="1"
                                        Margin="9,2,9,0"
                                        CornerRadius="1"
                                        Background="{StaticResource SpecularBrush}"
                                        Opacity="0.72"
                                        VerticalAlignment="Top"
                                        IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="Background" Value="{StaticResource GlassControlHoverBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource GlassBorderStrongBrush}" />
                                <Setter TargetName="LiquidButton" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.025" ScaleY="1.025" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#B00A111A" />
                                <Setter TargetName="LiquidButton" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.975" ScaleY="0.975" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RemoveButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFD9DE" />
            <Setter Property="Background" Value="#B0A62B38" />
            <Setter Property="BorderBrush" Value="#70FF9CA5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0C43A49" />
                                <Setter Property="BorderBrush" Value="#C0FFD1D6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource MenuSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer MaxHeight="{TemplateBinding MaxHeight}"
                                          VerticalScrollBarVisibility="Auto"
                                          CanContentScroll="True">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource MenuSurfaceBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Margin="3,1"
                                    Padding="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CheckMark"
                                               Text="*"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               Visibility="Collapsed"
                                               VerticalAlignment="Center" />
                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center" />
                                    <TextBlock x:Name="SubmenuArrow"
                                               Grid.Column="2"
                                               Text="&lt;"
                                               Foreground="{StaticResource AccentBrightBrush}"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Left"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{StaticResource MenuSurfaceBrush}"
                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="3">
                                    <ScrollViewer MaxHeight="640"
                                                  VerticalScrollBarVisibility="Auto"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#70505050" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#80606060" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkSeparatorStyle" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#30FFFFFF" Margin="10,5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <EventSetter Event="MouseEnter" Handler="TabItem_MouseEnter" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="TabBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                            </Border>
                            <Border x:Name="TabAccent"
                                    Height="2"
                                    Width="22"
                                    Margin="0,0,0,2"
                                    CornerRadius="1"
                                    Background="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Visibility="Collapsed" />
                            <Border x:Name="TabShine"
                                    Height="1"
                                    Margin="10,2,10,0"
                                    CornerRadius="1"
                                    Background="{StaticResource SpecularBrush}"
                                    Opacity="0.75"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="Background" Value="{StaticResource GlassControlBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
                                <Setter TargetName="TabAccent" Property="Visibility" Value="Visible" />
                                <Setter TargetName="TabShine" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="Background" Value="#40383838" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="DrawerSurface"
            CornerRadius="32,0,0,32"
            BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="1,1,0,1"
            Background="{StaticResource DrawerGlassBrush}">
        <Grid>
            <Border Margin="1,1,0,1"
                    CornerRadius="31,0,0,31"
                    BorderBrush="#34E5E1D8"
                    BorderThickness="1,1,0,0"
                    IsHitTestVisible="False" />
            <Grid Margin="20,18,20,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="SIDEDOCK" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Workspace"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource ChromeButton}" Click="PinButton_Click" Margin="0,0,6,0" ToolTip="Keep the drawer open">
                            <TextBlock x:Name="PinButtonText" Text="PIN" FontSize="10" FontWeight="Bold" />
                        </Button>
                        <Button Style="{StaticResource ChromeButton}" Click="EditButton_Click" Margin="0,0,6,0" ToolTip="Unlock layout editing">
                            <TextBlock x:Name="EditButtonText" Text="EDIT" FontSize="10" FontWeight="Bold" />
                        </Button>
                        <Button Style="{StaticResource ChromeButton}" Click="MenuButton_Click" ToolTip="SideDock options">
                            <TextBlock Text="..." FontSize="13" FontWeight="Bold" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <TabControl x:Name="DrawerTabs"
                                ItemsSource="{Binding Configuration.Tabs}"
                                Background="Transparent"
                                BorderThickness="0"
                                SelectedIndex="0">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
                            </ControlTemplate>
                        </TabControl.Template>
                        <TabControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:DockTab}">
                                <Grid>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               ToolTip="Double-click to rename in EDIT mode"
                                               Tag="{Binding ElementName=TabNameEditor}"
                                               PreviewMouseLeftButtonDown="TabName_PreviewMouseLeftButtonDown" />
                                    <TextBox x:Name="TabNameEditor"
                                             Text="{Binding Name, UpdateSourceTrigger=Explicit}"
                                             Visibility="Collapsed"
                                             MinWidth="56"
                                             MaxWidth="150"
                                             Padding="4,1"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             Background="#D0182330"
                                             BorderBrush="{StaticResource AccentBrush}"
                                             SelectionBrush="{StaticResource AccentBrush}"
                                             PreviewKeyDown="TabNameEditor_PreviewKeyDown"
                                             LostKeyboardFocus="TabNameEditor_LostKeyboardFocus" />
                                </Grid>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                    </TabControl>
                </Grid>

                <Border Grid.Row="2"
                        Background="{StaticResource GlassControlBrush}"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="28"
                        Padding="8">
                    <Grid>
                        <Border Height="1"
                                Margin="18,-6,18,0"
                                Background="{StaticResource SpecularBrush}"
                                Opacity="0.6"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False" />
                        <ContentControl Content="{Binding ElementName=DrawerTabs, Path=SelectedItem}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate DataType="{x:Type models:DockTab}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Items}"
                                                  AllowDrop="True"
                                                  Drop="Drawer_Drop"
                                                  HorizontalContentAlignment="Stretch">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="ItemsPanel">
                                                    <Setter.Value>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UseFullWidthRows}" Value="True">
                                                        <Setter Property="ItemsPanel">
                                                            <Setter.Value>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Vertical" />
                                                                </ItemsPanelTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:DockItem}">
                                                <Grid x:Name="ItemContainer" Width="108" Height="102" Margin="3">
                                                    <Button x:Name="TileButton"
                                                            Tag="{Binding}"
                                                            AutomationProperties.Name="{Binding Label}"
                                                            ToolTip="{Binding Path}"
                                                            Click="TileButton_Click"
                                                            PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown"
                                                            PreviewMouseMove="Tile_PreviewMouseMove"
                                                            PreviewMouseRightButtonUp="Tile_PreviewMouseRightButtonUp"
                                                            DragOver="Tile_DragOver"
                                                            Drop="Tile_Drop"
                                                            AllowDrop="True"
                                                            Style="{StaticResource TileButtonStyle}"
                                                            Cursor="Hand">
                                                        <Border x:Name="TileSurface"
                                                                Background="{StaticResource GlassTileBrush}"
                                                                BorderBrush="{StaticResource GlassBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="20"
                                                                Padding="10"
                                                                RenderTransformOrigin="0.5,0.5">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                                            </Border.RenderTransform>
                                                            <Grid>
                                                                <Grid x:Name="TileContent">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="*" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Border Width="48"
                                                                        Height="48"
                                                                        CornerRadius="14"
                                                                        Background="{StaticResource GlassControlHoverBrush}"
                                                                        Opacity="0.42"
                                                                        HorizontalAlignment="Center" />
                                                                <Border Width="42"
                                                                        Height="42"
                                                                        CornerRadius="12"
                                                                        Background="#70151515"
                                                                        BorderBrush="#48D8D4CB"
                                                                        BorderThickness="1"
                                                                        HorizontalAlignment="Center">
                                                                    <Grid>
                                                                        <Image x:Name="ShellTileIcon"
                                                                               Source="{Binding Path, Converter={StaticResource PathIconConverter}}"
                                                                               Width="30" Height="30" Stretch="Uniform" />
                                                                        <Control x:Name="ModernFolderIcon"
                                                                                 Width="30"
                                                                                 Height="30"
                                                                                 Template="{StaticResource FolderIconTemplate}"
                                                                                 Visibility="Collapsed" />
                                                                        <Control x:Name="PdfTileIcon"
                                                                                 Width="30"
                                                                                 Height="30"
                                                                                 Template="{StaticResource PdfIconTemplate}"
                                                                                 Visibility="Collapsed" />
                                                                    </Grid>
                                                                </Border>
                                                                <TextBlock Grid.Row="1"
                                                                           Text="{Binding Label}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           TextAlignment="Center"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           Margin="0,8,0,0" />
                                                                 <Border x:Name="HoverTint"
                                                                        Grid.RowSpan="2"
                                                                        Margin="-10"
                                                                        CornerRadius="20"
                                                                        Background="#70FFFFFF"
                                                                         Opacity="0"
                                                                         IsHitTestVisible="False" />
                                                                </Grid>
                                                                <Grid x:Name="RowContent" Visibility="Collapsed">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center">
                                                                        <Image x:Name="ShellRowIcon"
                                                                               Source="{Binding Path, Converter={StaticResource PathIconConverter}}"
                                                                               Width="34"
                                                                               Height="34" />
                                                                        <Control x:Name="ModernRowFolderIcon"
                                                                                 Width="34"
                                                                                 Height="34"
                                                                                 Template="{StaticResource FolderIconTemplate}"
                                                                                 Visibility="Collapsed" />
                                                                        <Control x:Name="PdfRowIcon"
                                                                                 Width="34"
                                                                                 Height="34"
                                                                                 Template="{StaticResource PdfIconTemplate}"
                                                                                 Visibility="Collapsed" />
                                                                    </Grid>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding Label}"
                                                                               TextWrapping="Wrap"
                                                                               FontSize="13"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                                               VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                    <Button HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Width="24" Height="24"
                                                            Margin="0,-4,-4,0"
                                                            Tag="{Binding}"
                                                            Content="x"
                                                            FontWeight="Bold"
                                                            Cursor="Hand"
                                                            Click="RemoveTileButton_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource RemoveButtonStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                                            <Condition Binding="{Binding IsReadOnly}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.UseFullWidthRows, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                        <Setter TargetName="ItemContainer" Property="Width" Value="Auto" />
                                                        <Setter TargetName="ItemContainer" Property="Height" Value="Auto" />
                                                        <Setter TargetName="TileContent" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="RowContent" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding UseModernFolderIcon}" Value="True">
                                                        <Setter TargetName="ShellTileIcon" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="ModernFolderIcon" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="ShellRowIcon" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="ModernRowFolderIcon" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPdf}" Value="True">
                                                        <Setter TargetName="ShellTileIcon" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="PdfTileIcon" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="ShellRowIcon" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="PdfRowIcon" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=TileButton}" Value="True">
                                                        <Setter TargetName="HoverTint" Property="Opacity" Value="0.16" />
                                                        <Setter TargetName="TileSurface" Property="BorderBrush" Value="{StaticResource GlassBorderStrongBrush}" />
                                                        <Setter TargetName="TileSurface" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="1.015" ScaleY="1.015" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPressed, ElementName=TileButton}" Value="True">
                                                        <Setter TargetName="HoverTint" Property="Opacity" Value="0.08" />
                                                        <Setter TargetName="TileSurface" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="3" x:Name="StatusLabel" Margin="4,10,4,0" Text="Ready" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
